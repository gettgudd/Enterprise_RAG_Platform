# App
APP_ENV=local
APP_NAME=enterprise-rag-platform
LOG_LEVEL=INFO
API_PORT=8000

# Vector Database (ChromaDB as primary per architecture diagram)
VECTOR_DB_TYPE=chromadb
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=enterprise_documents

# Secondary / Alternative Vector DB (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_chunks

# PostgreSQL (Application Database for users, permissions, chat history, feedback)
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Caching, session state, rate limiting)
REDIS_URL=redis://redis:6379/0

# Object Storage (AWS S3 for uploaded PDF, Word, Excel, PPT files)
S3_BUCKET_NAME=enterprise-rag-documents
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
LOCAL_STORAGE_DIR=data/storage

# Embeddings & RAG
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# LLM Providers (OpenAI, Anthropic, Gemini, or local)
LLM_PROVIDER=
LLM_API_KEY=

# Authentication & RBAC (JWT / OAuth)
JWT_SECRET=change_me_super_secret_jwt_key_32_bytes_long
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Storage Paths
DATA_DIR=data
MODEL_CACHE_DIR=models_cache
